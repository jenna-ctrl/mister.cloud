# Daily analytics email — set these in Vercel → Project → Settings → Environment
# Variables (Production). Do NOT commit real values; this file is a template.

# Plausible (privacy-friendly analytics)
PLAUSIBLE_SITE_ID=mister.cloud
PLAUSIBLE_API_KEY=            # Plausible → Settings → API Keys (Stats API key)
# PLAUSIBLE_HOST=https://plausible.io   # only for self-hosted Plausible

# Resend (transactional email)
RESEND_API_KEY=              # Resend → API Keys
REPORT_TO=shailin@futureprooftmt.com
REPORT_FROM=Mister Cloud Analytics <analytics@mister.cloud>   # domain must be verified in Resend

# Cron protection — any long random string. Vercel Cron sends it as a Bearer token.
CRON_SECRET=
